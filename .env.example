# Copy to .env.local and fill in, then restart `pnpm dev`.

# OAuth client ID (Google Cloud → Credentials → OAuth client ID → Web application).
# Used by the browser for sign-in AND by the server to check tokens.
VITE_GOOGLE_CLIENT_ID=

# Optional: comma-separated Google accounts allowed in. Empty = any Google
# account (each still only sees its own projects).
ALLOWED_EMAILS=

# Optional fallback when not signed in (link-shared folders only).
VITE_GOOGLE_API_KEY=
